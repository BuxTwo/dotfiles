{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "fixed-center": true,

    "modules-left": [
        "custom/launcher",
        "battery",
        "cpu",
        "memory",
        "temperature"
    ],

    "modules-center": ["niri/workspaces"],

    "modules-right": [
        "pulseaudio",
        "backlight",
        "niri/language",
        "clock",
        "custom/power",
        "tray"
    ],

    "custom/power": {
        "format" : "<span color='#f38ba8'></span>",
        "on-click": "powermenu.sh",
        "tooltip": false
    },
    "custom/launcher": {
        "format": "<span color='#89b4fa'></span>",
        "on-click": "fuzzel",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "format-alt": "{:%d %m %Y}",
        "tooltip": false
    },
    "niri/language": {
        "format": "{short}",
        "on-click": "niri msg action switch-layout next"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "scroll-step": 2,
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 5,
        "format": "<span color='#a6e3a1'>{icon}</span> {capacity}%",
        "format-warning": "<span color='#f9e2af'>{icon}</span> {capacity}%",
        "format-critical": "<span color='#f38ba8'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#a6e3a1'>{icon}</span> {capacity}%",
        "format-plugged": "<span color='#f9e2af'></span> {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
    },
    "network": {
        "format-wifi": "<span color='#eba0ac'>{icon}</span>",
        "format-ethernet": "<span color='#94e2d5'>󰈀</span>",
        "format-disconnected": "<span color='#f38ba8'>󱞐</span>",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤢 ", "󰤨 "],
        "on-click": "nm-connection-editor",
        "tooltip-format-wifi": "{essid}",
        "tooltip-format-ethernet": "{ifname}"
    },
    "pulseaudio": {
        "format": "<span color='#fab387'>{icon}</span> {volume}%",
        "format-icons": {
            "default": ["", "", "", "", "", "", " ", " ", " "],
            "headphone": ""
        },
        "format-muted": "<span color='#f38ba8'></span>",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 2
    },
    "cpu": {
        "interval": 5,
        "format": "<span color='#f5c2e7'></span>  {usage}%",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": "<span color='#cba6f7'></span>  {used:0.1f}G",
        "tooltip": false
    },
    "temperature": {
        "interval": 5,
        // "thermal-zone": 28,
        "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon6/temp1_input",
        "critical-threshold": 80,
        "format-critical": "<span color='#f38ba8'>{icon}</span> {temperatureC}°C",
        "format": "<span color='#f9e2af'>{icon}</span> {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip": false
    },
    "niri/workspaces": {
        "format": "{icon}",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down",
        "format-icons": {
            "default": "",
            "empty": ""
        },
        "tooltip": false
    }
}
